{
  "name": "honeyweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repository-aware deception graphs powered by Meta models",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "scan": "node --import tsx src/cli.ts scan",
    "generate": "node --env-file-if-exists=.env --import tsx src/cli.ts generate",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "vite": "^7.3.1"
  }
}
